    apply_force_column_12_fix(system)
    ```
    """)
    
    # Тест на файле Барыс
    if st.button("🧪 Тест принудительного извлечения"):
        barys_file = "/mnt/f/Работа-Никита/Autosort_tovar/барыс - прод с мая24-май25.xlsx"
        
        with st.spinner("Тестирую принудительное извлечение..."):
            df = pd.read_excel(barys_file)
            prices_df = force_extract_prices_from_column_12(df, "барыс - прод с мая24-май25.xlsx")
            
            if not prices_df.empty:
                items_with_prices = (prices_df['цена'] > 0).sum()
                st.success(f"✅ Принудительно извлечено {items_with_prices} цен из {len(prices_df)} товаров")